{
  "name": "sistema-agendamento-barbearia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts tests *.ts *.mjs *.json *.yaml *.md",
    "test:browser": "playwright test",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --env-file=.env.local --test tests/integration/*.test.ts",
    "local:setup": "node scripts/local-setup.mjs",
    "assets": "node scripts/assets.mjs",
    "db:up": "docker compose --env-file .env.local up -d db",
    "db:migrate": "tsx scripts/guarded-migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "wa:mock:once": "node --env-file=.env.local scripts/wa-mock-worker.mjs",
    "wa:mock:watch": "node --env-file=.env.local scripts/wa-mock-worker.mjs --watch",
    "wa:meta:preview": "tsx --env-file=.env.local scripts/wa-meta-worker.ts --preview",
    "wa:meta:once": "tsx --env-file=.env.local scripts/wa-meta-worker.ts",
    "wa:meta:watch": "tsx --env-file=.env.local scripts/wa-meta-worker.ts --watch"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
